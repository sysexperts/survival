; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SerdarsGame"
config/description="2.5D isometric survival - Tile-Stacking Prototype"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Net="*res://scripts/net.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

; Ein Pixel-Font fuer die gesamte Oberflaeche. 22 = die doppelte
; Rastergroesse der Vorlage (11 px), damit jedes Schriftpixel genau zwei
; Bildschirmpixel breit ist und nichts verwaschen wirkt.
theme/custom="res://resources/pixel_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.1, 0.11, 0.15, 1)
